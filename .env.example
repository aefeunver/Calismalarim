# Copy to .env. Never commit real passwords.
POSTGRES_USER=adem
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=odev
PGADMIN_DEFAULT_EMAIL=adem@example.com
PGADMIN_DEFAULT_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD
# Loopback is the safe default. Windows access can use an SSH tunnel.
BIND_IP=127.0.0.1
POSTGRES_PORT=5432
PGADMIN_PORT=5050
NEXUS_PORT=8081
NEXUS_IMAGE=sonatype/nexus3:3.77.2-java17-alpine
PGADMIN_IMAGE=dpage/pgadmin4:9.18
